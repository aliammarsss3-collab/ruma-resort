# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by git and must never be committed.

SECRET_KEY=change-this-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Comma-separated list of frontend origins allowed to call /api/*
# e.g. https://your-username.github.io
FRONTEND_ORIGIN=*

# Optional: point to a different database (defaults to local SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

FLASK_ENV=development
PORT=5000
